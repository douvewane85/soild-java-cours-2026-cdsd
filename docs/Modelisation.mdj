						{
							"_type": "UMLNoteView",
							"_id": "AAAAAAGexv0nhxsFVZA=",
							"_parent": {
								"$ref": "AAAAAAGexvyuARgYM/4="
							},
							"font": "Arial;13;0",
							"left": 8,
							"top": 400,
							"width": 369,
							"height": 193,
							"text": "public double calculFrais(double montant,String methode){\n    if(methode.equals(\"ORANGE_MONEY\"))  {\n        return montant*0.01;\n        }\n        else if(methode.equals(\"WAVE\")){\n            return montant*0.015;\n        }else if(methode.equals(\"CARTE_BANCAIRE\")){\n            return montant*0.02;\n        }\n        return 0;\n    }"
						},
